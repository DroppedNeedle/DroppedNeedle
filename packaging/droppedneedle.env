# Settings for the DroppedNeedle service, read at each start. Everything else
# is set in the web UI. Uncomment a line to change it, then run
# `sudo systemctl restart droppedneedle`. The configuration guide lists every
# variable.

# Port the web UI and the APIs answer on.
#PORT=8688

# auto listens on IPv4 and IPv6. Set 0.0.0.0, :: or one interface address to
# pin it.
#BIND_HOST=auto

# Serve under a sub-path behind a reverse proxy.
#BASE_PATH=/music

# Addresses whose X-Forwarded-* headers are trusted: your reverse proxy.
#TRUSTED_PROXY_IPS=127.0.0.1,::1

# Time zone for scheduled scans. Unset, the system's zone is used.
#TZ=Europe/London

# Where slskd puts finished downloads, as this machine sees the folder.
#SLSKD_DOWNLOADS_PATH=/srv/slskd/downloads

# The data folder. Point it at a v2 install's folder to upgrade it.
#ROOT_APP_DIR=/var/lib/droppedneedle
